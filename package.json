{
  "name": "open-file-backup-manager",
  "productName": "Open File Backup Manager",
  "version": "1.0.0",
  "description": "Flexible local backup profiles for Windows",
  "main": "desktop/main.cjs",
  "author": "Open File Backup Manager contributors",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node tools/preview.cjs",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:dir": "electron-builder --win --x64 --dir --publish never",
    "design:check": "node tools/design-sync.cjs",
    "design:sync": "node tools/design-sync.cjs --apply"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.openfilebackupmanager.desktop",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "index.html",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en_US"
      ],
      "multiLanguageInstaller": false
    },
    "artifactName": "Open-File-Backup-Manager-${version}-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "johnkai-kai",
        "repo": "Open-File-Backup-Manager",
        "releaseType": "release"
      }
    ]
  },
  "license": "MIT"
}
